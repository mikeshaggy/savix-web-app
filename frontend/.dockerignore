# Deny by default. No host dependencies, standalone output, or private config.
**
!package.json
!package-lock.json
!next.config.mjs
!eslint.config.mjs
!postcss.config.mjs
!jsconfig.json
!src
!src/**
!public
!public/**

# These exclusions apply even inside an allowed source directory.
**/.git
**/.git/**
**/.local
**/.local/**
**/.env
**/.env.*
**/*.env
**/*.env.*
**/secrets
**/secrets/**
**/keys
**/keys/**
**/.ssh
**/.ssh/**
**/.private
**/.private/**
**/.misc
**/.misc/**
**/credentials*
**/id_rsa*
**/id_ed25519*
**/jwt-private-key*
**/jwt-public-key*
**/*.der
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.crt
**/*.cer
**/*.log
**/*.dump
**/*.bak
**/*.backup
**/*.tar*
**/node_modules
**/.next
**/target
**/build
**/dist
**/coverage
**/*.jar
**/*.war
**/.DS_Store
