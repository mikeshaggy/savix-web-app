# Deny by default. Only Maven inputs, source, and required resources are sent.
**
!mvnw
!pom.xml
!.mvn
!.mvn/wrapper
!.mvn/wrapper/maven-wrapper.properties
!src
!src/**
# Local Spring overrides and credential dumps must never enter a JAR.
**/application-local*
**/temp
**/temp/**

# These exclusions apply even inside an allowed source directory.
**/.git
**/.git/**
**/.local
**/.local/**
**/.env
**/.env.*
**/*.env
**/*.env.*
**/secrets
**/secrets/**
**/keys
**/keys/**
**/.ssh
**/.ssh/**
**/.private
**/.private/**
**/.misc
**/.misc/**
**/credentials*
**/id_rsa*
**/id_ed25519*
**/jwt-private-key*
**/jwt-public-key*
**/*.der
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.crt
**/*.cer
**/*.log
**/*.dump
**/*.bak
**/*.backup
**/*.tar*
**/node_modules
**/.next
**/target
**/build
**/dist
**/coverage
**/*.jar
**/*.war
**/.DS_Store
