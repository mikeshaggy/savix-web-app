# Documentation only. Empty required values intentionally fail validation.
# Use existing production values outside Git; never generate replacement keys.
BACKEND_IMAGE=
FRONTEND_IMAGE=
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:alpine
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:latest
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:latest
POSTGRES_DB=savix
POSTGRES_USER=savix-admin
POSTGRES_PASSWORD=
POSTGRES_EXPORTER_DATA_SOURCE_NAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FRONTEND_URL=https://savix.mikeshaggy.com
# Runtime only; never supply these as Docker build arguments.
PROXY_BASE=http://savix-backend:8000
PROXY_SECRET=
EMAIL_FROM=
EMAIL_FROM_NAME=Savix
JWT_ISSUER=
JWT_AUDIENCE=
# Absolute protected host file paths outside the checkout/build contexts.
# Preserve the existing pair; backend container UID/GID is 10001:10001.
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY_FILE=
COOKIE_DOMAIN=
